# Local CUPS print server (run: pnpm print-server)
PRINT_SERVER_PORT=3847
PRINTER_NAME=
CUPS_MEDIA_OPTION=Postcard

# Next.js frontend → print server URL
NEXT_PUBLIC_PRINT_SERVER_URL=http://127.0.0.1:3847

# Connect the photobooth Blob store to your Vercel project, then:
#
# Option A (recommended): enable Development for blob vars in Vercel → Settings → Environment Variables
#   then: vercel env pull
#
# Option B: pull Preview vars and merge BLOB_* into .env.local:
#   vercel env pull .env.preview.local --environment=preview
#   grep '^BLOB_' .env.preview.local >> .env.local
#
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
