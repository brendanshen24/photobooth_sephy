{
  "name": "selphy-photobooth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,print -c cyan,magenta \"next dev -p 3001\" \"pnpm print-server:dev\"",
    "dev:web": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "print-server": "pnpm --dir print-server start",
    "print-server:dev": "pnpm --dir print-server dev",
    "print-server:install": "pnpm --dir print-server install"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "next": "^15.1.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
